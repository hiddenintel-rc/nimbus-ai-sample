# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will never be committed.

# LaunchDarkly — Test environment (server-side SDK key, keep secret)
LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# LaunchDarkly — Test environment (client-side ID, safe to expose in the browser)
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Inference provider: "local" (default, your own hosted models) or "groq" (manual fallback).
# Not automatic — chosen deliberately so nothing can silently incur Groq charges.
INFERENCE_PROVIDER=local

# Local AI stack (Open WebUI's OpenAI-compatible API). Never point this at
# llama.cpp's own port directly — that stays loopback-only by design.
#
# Running alongside Open WebUI (the self-hosted deployment): use its internal
# address, e.g. http://open-webui:8080/api on a shared Docker network. The call
# never leaves the host, so the Cloudflare variables below stay blank.
#
# Running anywhere else: use the public Cloudflare Tunnel hostname whose Access
# application has a single Service Auth policy (no human login path), and fill
# in the service token below.
LOCAL_AI_BASE_URL=http://open-webui:8080/api
LOCAL_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Access service token — only needed when LOCAL_AI_BASE_URL is the
# public tunnel hostname. Leave blank when reaching Open WebUI internally.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Groq (optional manual fallback — only read when INFERENCE_PROVIDER=groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared password for the three demo accounts (demo-free / demo-pro /
# demo-enterprise @nimbus.app). Logins are disabled until this is set.
# Never commit the real value.
DEMO_PASSWORD=choose-a-password

# NextAuth (Auth.js) — any random string works for local dev.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required when serving from a custom domain behind a reverse proxy or tunnel
# (the self-hosted deployment). Auth.js only trusts the request host
# automatically on Vercel; without this, logins fail on the callback. Not
# needed for local dev or Vercel.
AUTH_TRUST_HOST=true

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.tools
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (placeholder template is safe and intentionally committed)
.env*
!.env.example

# vercel
.vercel

# local tool/session config (not needed to run the project)
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
